{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Linux",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/NEURAL_AMP_MODELER_artefacts/Debug/Standalone/Neural Amp Modeler",
            "args": [],
            "stopAtEntry": false,
             "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build-debug-linux",
            "miDebuggerPath": "/usr/bin/gdb"
        },
        {
            "name": "Debug Reaper",
            "type": "cppdbg",
            "request": "launch",
            "program": "${userHome}/opt/REAPER/reaper",
            "args": [],
            "stopAtEntry": false,
             "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build-debug-linux",
            "miDebuggerPath": "/usr/bin/gdb"
        }
    ]
}